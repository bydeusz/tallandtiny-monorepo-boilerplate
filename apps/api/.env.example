NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
CACHE_TTL=60000
ALLOWED_EMAIL_DOMAINS=bydeusz.com
REGISTRATION_ENABLED=true
FRONTEND_URL=http://localhost:3000

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

DATABASE_URL=postgresql://tallandtiny:tallandtiny@localhost:5432/tallandtiny?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

# Platform super admin — used by `pnpm db:seed:super-admin` (idempotent).
SUPER_ADMIN_EMAIL=admin@bydeusz.com
SUPER_ADMIN_PASSWORD=change-me-please

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tall & Tiny <noreply@tallandtiny.app>"
SUPPORT_EMAIL=support@tallandtiny.app

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tallandtiny
S3_SECRET_KEY=tallandtiny-secret
S3_BUCKET=tallandtiny
